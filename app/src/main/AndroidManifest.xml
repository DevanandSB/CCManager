<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the user's own IMAP server (statement sync). No other network use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Explicit queries for installed Indian bank, card, UPI, and messaging apps for source filter UI. -->
    <queries>
        <package android:name="com.snapwork.hdfc" />
        <package android:name="com.hdfcbank.payzapp" />
        <package android:name="com.hdfc.mycards" />
        <package android:name="com.tatadigital.tcp" />
        <package android:name="com.csam.icici.bank.imobile" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.sbicard.android" />
        <package android:name="com.sbi.lotusintouch" />
        <package android:name="com.sbi.SBF" />
        <package android:name="com.axis.mobile" />
        <package android:name="money.super.app" />
        <package android:name="com.freecharge.android" />
        <package android:name="com.msf.kbank.mobile" />
        <package android:name="com.kotak811mobilebankingapp.instanepay" />
        <package android:name="indwin.c3.shareapp" />
        <package android:name="com.aubank.aumobile.retail" />
        <package android:name="com.idfcfirstbank.optimus" />
        <package android:name="com.fss.indus" />
        <package android:name="com.indusind.indie" />
        <package android:name="in.fedmobile" />
        <package android:name="cards.scapia.app" />
        <package android:name="com.epifi.paisa" />
        <package android:name="money.jupiter" />
        <package android:name="com.csb.mobile" />
        <package android:name="com.rblbank.mobank" />
        <package android:name="com.rbl.mycard" />
        <package android:name="com.yesbank.yesmobile" />
        <package android:name="in.gokiwi.kiwi" />
        <package android:name="com.fpl.onetap" />
        <package android:name="com.americanexpress.android.acctsvcs.us" />
        <package android:name="com.americanexpress.android.acctsvcs.in" />
        <package android:name="com.hsbc.hsbcindia" />
        <package android:name="com.bobcard" />
        <package android:name="com.bankofbaroda.mconnect" />
        <package android:name="com.scb.breezebanking.in" />
        <package android:name="com.roarbank" />
        <package android:name="com.unitybank" />
        <package android:name="net.one97.paytm" />
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.samsung.android.messaging" />
    </queries>

    <application
        android:name=".CardsApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="CC Manager"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Cards">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher shortcuts: Add / Scan / Tap card. Matched by action rather than an explicit
                 targetPackage, so they also work for the .debug applicationId. -->
            <intent-filter>
                <action android:name="com.devanandsb.ccmanager.action.ADD_CARD" />
                <action android:name="com.devanandsb.ccmanager.action.SCAN_CARD" />
                <action android:name="com.devanandsb.ccmanager.action.TAP_CARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Share a statement PDF to Cards (e.g. from a Gmail attachment). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Card autofill for checkouts: suggestions show name + last four; filling needs fingerprint or PIN. -->
        <service
            android:name=".autofill.CardAutofillService"
            android:exported="true"
            android:label="CC Manager"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Cards.Unlock" />

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.ActionReceiver" android:exported="false" />
        <receiver android:name=".reminders.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- Sent explicitly to the app when exact-alarm permission is granted: re-set alarms as exact. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
