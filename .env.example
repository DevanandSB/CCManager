# Copy this file to `.env` for local builds and private statement testing.
# `.env` is ignored by Git and MUST NEVER be committed.

# Release APK signing credentials (used by app/build.gradle.kts)
RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# Optional developer statement probe (used by StatementProbe.kt)
# STMT_PROBE=Issuer|/abs/path/to/statement.pdf|PDF_PASSWORD_ENV_VAR
# STMT_OUT=/abs/path/to/output_dir

# Optional private sample PDF test expectations (kept out of version control)
# Format: last4|statementDate|periodStart|dueDate|totalPaise|minPaise|openingPaise|limitPaise|txnCount|debitsPaise|creditsPaise|pointsEarned|pointsBalance|cashbackPaise|rewardsUnit|extra1|extra2
# SAMPLE_PDF_ICICI=
# SAMPLE_PDF_AU=
# SAMPLE_PDF_YES=
# SAMPLE_PDF_AXIS=
# SAMPLE_PDF_SLICE=
